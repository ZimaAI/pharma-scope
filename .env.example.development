# Local development database, separate from test and production.
# Create pharmascope_dev in the isolated local PostgreSQL before use.
PHARMA_RUNTIME_MODE=replay
PHARMA_PUBLIC_ORIGIN=http://localhost:18181
PHARMA_COOKIE_SECURE=0
PHARMA_ALLOW_DEV_HEADER=0
CORS_ALLOW_ORIGINS=http://localhost:18181
PHARMA_DATABASE_URL=postgresql+psycopg://pharma_test@127.0.0.1:18432/pharmascope_dev
PHARMA_DEMO_PASSWORD=demo
NEXT_PUBLIC_PHARMA_RUNTIME_MODE=replay
NEXT_PUBLIC_PHARMA_API_URL=
NEXT_PUBLIC_PHARMA_WORKSPACE_ID=dee59b72-2cb2-5255-934c-b44a3fd8911c
PHARMA_WEB_PORT=18181
PH_REAL_EMAIL_ENABLED=false
PH_SMTP_DRY_RUN=true
PHARMA_WORKER_POLL_SECONDS=2
