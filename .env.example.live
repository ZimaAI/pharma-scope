# LIVE. Copy outside Git to /etc/pharmascope/pharmascope.env (chmod 0600).
# Compose: deploy/compose.sh /absolute/private/file up -d
# systemd: change db hostname to the dedicated PostgreSQL endpoint before install.
PHARMA_RUNTIME_MODE=live
PHARMA_PUBLIC_ORIGIN=https://pharmascope.zimagent.top
PHARMA_COOKIE_SECURE=1
PHARMA_ALLOW_DEV_HEADER=0
CORS_ALLOW_ORIGINS=https://pharmascope.zimagent.top
PHARMA_DATABASE_URL=postgresql+psycopg://pharma:CHANGE_ME@db:5432/pharma
POSTGRES_USER=pharma
POSTGRES_DB=pharma
POSTGRES_PASSWORD=CHANGE_ME
# CLI bootstrap only; remove from long-lived service config after user creation.
# PHARMA_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# GPT Researcher calls this real OpenAI-compatible chat endpoint.
OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=https://api.openai.com/v1
PHARMA_MODEL=CHANGE_ME

# Static export uses the same origin; never use a localhost API URL in production.
NEXT_PUBLIC_PHARMA_RUNTIME_MODE=live
NEXT_PUBLIC_PHARMA_API_URL=
NEXT_PUBLIC_PHARMA_WORKSPACE_ID=
PHARMA_WEB_PORT=18181

# Official ClinicalTrials.gov API v2 has no API key requirement.
CTGOV_API_BASE_URL=https://clinicaltrials.gov/api/v2
PUBMED_API_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# Set a real operator contact email; NCBI_API_KEY is optional.
NCBI_EMAIL=
NCBI_API_KEY=
PHARMA_SOURCE_TIMEOUT=30
PHARMA_SOURCE_RETRIES=3
PHARMA_SOURCE_MIN_INTERVAL=0.35

# SMTP is disabled and dry-run by default; BOTH switches are needed for sending.
PH_REAL_EMAIL_ENABLED=false
PH_SMTP_DRY_RUN=true
PH_SMTP_HOST=
PH_SMTP_PORT=587
PH_SMTP_USER=
PH_SMTP_PASSWORD=
PH_SMTP_FROM=

# One durable research worker per deployment.
PHARMA_WORKER_POLL_SECONDS=2

# Enforced deployment ceilings; each request may choose a smaller budget.
PH_MAX_TOOL_CALLS=20
PH_MAX_MODEL_CALLS=12
PH_MAX_RECORDS=100
PH_MAX_TOKENS=50000
PH_MAX_SECONDS=600
