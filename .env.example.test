# Isolated PostgreSQL integration tests. NEVER point this at a production DB.
# deploy/test-postgres.sh start creates a local-only PG16 instance at this port.
PHARMA_RUNTIME_MODE=replay
PHARMA_DATABASE_URL=postgresql+psycopg://pharma_test@127.0.0.1:18432/pharmascope_test
PHARMA_TEST_DATABASE_URL=postgresql+psycopg://pharma_test@127.0.0.1:18432/pharmascope_test
PHARMA_ALLOW_DEV_HEADER=1
PHARMA_COOKIE_SECURE=0
PH_REAL_EMAIL_ENABLED=false
PH_SMTP_DRY_RUN=true
