# Production image for the PharmaScope API and worker.
# Build from the repository root: docker build -f deploy/Dockerfile.api .
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY backend/requirements-runtime.lock ./backend/requirements-runtime.lock
RUN python -m pip install -r backend/requirements-runtime.lock

COPY . .
RUN useradd --create-home --uid 10001 pharmascope \
    && mkdir -p /var/lib/pharmascope/artifacts \
    && chown -R pharmascope:pharmascope /app /var/lib/pharmascope
USER pharmascope

EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3)"
CMD ["uvicorn", "backend.pharma_scope_app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
