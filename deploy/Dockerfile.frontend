FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/nextjs/package*.json ./
RUN npm ci --legacy-peer-deps
COPY frontend/nextjs/ ./
ARG NEXT_PUBLIC_PHARMA_API_URL=
ARG NEXT_PUBLIC_PHARMA_WORKSPACE_ID=
ARG NEXT_PUBLIC_PHARMA_RUNTIME_MODE=live
ENV NEXT_PUBLIC_PHARMA_API_URL=$NEXT_PUBLIC_PHARMA_API_URL \
    NEXT_PUBLIC_PHARMA_WORKSPACE_ID=$NEXT_PUBLIC_PHARMA_WORKSPACE_ID \
    NEXT_PUBLIC_PHARMA_RUNTIME_MODE=$NEXT_PUBLIC_PHARMA_RUNTIME_MODE
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/out /usr/share/nginx/html
COPY deploy/nginx.compose.conf /etc/nginx/conf.d/default.conf
HEALTHCHECK --interval=20s --timeout=5s --retries=5 \
  CMD wget --spider --quiet http://127.0.0.1/healthz || exit 1
