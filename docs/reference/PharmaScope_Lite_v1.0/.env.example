# No real credentials. Services/adapter are not implemented in this document pack.
PH_MODE=demo
PH_RUNTIME=replay
PH_CONFIG_PATH=/app/config/lite.yaml
PH_DATABASE_URL=postgresql+psycopg://pharma:CHANGE_ME@db:5432/pharma
PH_SESSION_SECRET=CHANGE_ME_WITH_CRYPTOGRAPHIC_RANDOM_VALUE
PH_PUBLIC_ORIGIN=http://localhost:8080
# In live mode explicitly configure all model roles; do not rely on upstream defaults.
PH_LLM_PROVIDER=
PH_LLM_BASE_URL=
PH_LLM_API_KEY=
PH_LLM_MODEL=
PH_LLM_INPUT_USD_PER_MILLION=
PH_LLM_OUTPUT_USD_PER_MILLION=
PH_EMBEDDING_ENABLED=false
PH_EMBEDDING_MODEL=
PH_EMBEDDING_API_KEY=
NCBI_API_KEY=
NCBI_TOOL=PharmaScopeLite
NCBI_EMAIL=
PH_REAL_EMAIL_ENABLED=false
PH_SMTP_HOST=
PH_SMTP_PORT=587
PH_SMTP_USER=
PH_SMTP_PASSWORD=
PH_SMTP_FROM=
# compose.target.yaml requires IMPLEMENTED and BUILT images/digests, not supplied here.
PH_NGINX_IMAGE=
PH_API_IMAGE=
PH_WORKER_IMAGE=
PH_POSTGRES_IMAGE=
POSTGRES_PASSWORD=
